  "/statement.week.change": {
   "post": {
    "operationId": "statement_week_change",
    "summary": "Changes the card's statement week; only after the caller agreed to the dates from statement.week.decide",
    "description": "Success is data.exitState OK with data.responseCode 0; data.statementWeek and data.statementDay come back as strings; tell the caller the dates from the preview. 400 INVALID_ARGUMENTS_ERROR, 500 FBE00099. No automatic retry: the call has a side effect.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "data"
        ],
        "properties": {
         "data": {
          "type": "object",
          "properties": {
           "cardNumber": {
            "type": "string",
            "description": "the cardNumber exactly as cards.list returned it"
           },
           "newStatementWeek": {
            "type": "string",
            "description": "the requested week, 1 to 4"
           },
           "statementDay": {
            "type": "string",
            "description": "the card's current statementDay from statement.week.get"
           }
          },
          "required": [
           "cardNumber",
           "newStatementWeek",
           "statementDay"
