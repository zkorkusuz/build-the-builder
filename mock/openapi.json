{
 "openapi": "3.0.3",
 "info": {
  "title": "Freya Bank voice services: statement and debt (the bank's test environment, mocked)",
  "version": "1.0.0",
  "description": "Every service is POST with a JSON body {data: {...}, call: {ani, lang}}; every answer has a result object (returnCode 1 and HTTP 200 mean success) and successful answers also have data. Error answers have only result (type ERROR or WARNING, code and message). Dates are dd.MM.yyyy strings, amounts JSON numbers. Always send cardNumber exactly as cards.list returned it."
 },
 "servers": [
  {
   "url": "https://bank-mock.bank-mock.workers.dev/voice/v1"
  }
 ],
 "paths": {
  "/cards.list": {
   "post": {
    "operationId": "cards_list",
    "summary": "The customer's active credit cards the assistant may talk about",
    "description": "Success: data.cards (cardNumber as the services expect it back, cardNumberLast4, productName free text and possibly empty, status, isMainCard), data.validCardsCount, data.exitState 1_CARD or MULTI_CARD. Two cards can share a product name and the last four digits. 404 FB_IVR_CHANNEL_102: the customer has no valid card (a warning, not a broken service). 500 FBE00099: technical error.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "data"
        ],
        "properties": {
         "data": {
          "type": "object",
          "properties": {
           "customerNo": {
            "type": "string",
            "description": "the customer number the phone menu handed over with the call"
           },
           "aiFlow": {
            "type": "string",
            "description": "which use case is asking; CardOps for this one"
           }
          },
          "required": [
           "customerNo",
           "aiFlow"
          ]
         },
         "call": {
          "type": "object",
          "description": "call metadata the bank logs; not checked in test",
          "properties": {
           "ani": {
            "type": "string",
            "description": "the caller's number"
           },
           "lang": {
            "type": "string",
            "description": "tr"
           }
          }
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "the customer's cards",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "data": {
           "type": "object",
           "properties": {
            "cards": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "cardNumber": {
                "type": "string"
               },
               "cardNumberLast4": {
                "type": "string"
               },
               "productName": {
                "type": "string"
               },
               "status": {
                "type": "string"
               },
               "isMainCard": {
                "type": "boolean"
               }
              }
             }
            },
            "validCardsCount": {
             "type": "number"
            },
            "exitState": {
             "type": "string"
            }
           }
          },
          "result": {
           "type": "object",
           "properties": {
            "guid": {
             "type": "string"
            },
            "returnCode": {
             "type": "string"
            },
            "messageText": {
             "type": "string"
            },
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "type": {
             "type": "string",
             "nullable": true
            },
            "details": {
             "type": "object",
             "properties": {
              "guid": {
               "type": "string"
              },
              "rootCause": {
               "type": "string",
               "nullable": true
              },
              "errorOrigin": {
               "type": "string",
               "nullable": true
              }
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "the customer has no valid card (FB_IVR_CHANNEL_102, a warning)",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "result": {
           "type": "object",
           "properties": {
            "guid": {
             "type": "string"
            },
            "returnCode": {
             "type": "string"
            },
            "messageText": {
             "type": "string"
            },
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "type": {
             "type": "string"
            },
            "details": {
             "type": "object",
             "properties": {
              "guid": {
               "type": "string"
              },
              "rootCause": {
               "type": "string"
              },
              "errorOrigin": {
               "type": "string"
              }
             }
