         "data": {
          "type": "object",
          "properties": {
           "cardNumber": {
            "type": "string",
            "description": "the cardNumber exactly as cards.list returned it"
           },
           "newStatementWeek": {
            "type": "string",
            "description": "the requested week, 1 to 4, never the card's current week"
           },
           "statementDay": {
            "type": "string",
            "description": "the card's current statementDay from statement.week.get"
           }
          },
          "required": [
           "cardNumber",
           "newStatementWeek",
           "statementDay"
          ]
         },
         "call": {
          "type": "object",
          "description": "call metadata the bank logs; not checked in test",
          "properties": {
