  "/statement.week.decide": {
   "post": {
    "operationId": "statement_week_decide",
    "summary": "Preview of a statement week change: the dates the card would get; changes nothing",
    "description": "data.statementDate and data.statementDueDate are the first statement and due date under the requested week, data.statementDay the new day, data.responseCode 0 and data.responseMessage. Do not call it for the week the card already has. 400 INVALID_ARGUMENTS_ERROR, 500 FBE00099.",
